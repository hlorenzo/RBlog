{
p <- ncol(X)
n <- nrow(X)
N <- length(lambda)
beta_estimate<- matrix(NA,N,p)
# for(l in 1:N){
l <- 1
TEST <- T
while(TEST)
{
b <- rep(0,p)
r <- y
lam <- lambda[l]*n
test <- T
iter <- 0
while(test)
{
b_previous<-b
for(j in 1:p){
r <- r+X[,j]*b[j]
Xj<-(sum(X[,j]*X[,j]))^(-1)
z<-sum(X[,j]*r)
b[j] <- (abs(z)-lam)*Xj
b[j] <- sign(z)*ifelse(b[j]>0,b[j],0)
r <- r-X[,j]*b[j]
}
error<-sum((b_previous-b)^2)
if(iter==maxIter | error<errorMin)
{
test <- F
}
else
{
iter <- iter + 1
}
}
b_1_l <- sum(abs(b))
beta_estimate[l,] <- b
if(l==N | b_1_l>b_1)
{
TEST <- F
}
else
{
l <- l+1
}
}
beta_estimate
}
sparseSIR <- function(X,Y,H=10,lambda,b_1=0.5,eta,
errorMin=1e-9,maxIter=50,
toPlot=F){
n <- nrow(X)
p <- ncol(X)
ordo <- order(Y)
x <- X[ordo,,drop=F]
sdx <- apply(x,2,sd)
x_tilde <- scale(x)
y <- Y[ordo]
reste <- n%%H
pace <- (n-reste)/H
slices <- NULL
n_j <- NULL
for(h in 1:H)
{
extra <- 0
if(h<=reste) extra <- 1
pace_h <- pace + extra
slices <- c(slices,rep(h,pace_h))
n_j <- c(n_j,pace_h)
}
S <- do.call(cbind,lapply(1:H,{function(h){out <- rep(0,n);out[which(slices==h)]<-1;out}}))
W <- cov(S)
s_bar <- n_j/n
X_js <- list()
for(h in 1:H)
{
X_js[[h]] <- colMeans(x[which(slices==h),,drop=F])
}
mu_X <- colMeans(X)
M <- matrix(0,H,p)
for(h in 1:H)
{
M[h,] <- s_bar[h]*(X_js[[h]]-mu_X)
}
W_inv <- matrix(1/(H+1),H,H) + diag(s_bar)
W_invM <- W_inv%*%M
Sigma <- cov(x)
test <- T
iter <- 1
c_vect <- rnorm(h)
b_previous <- rnorm(p)
while(test)
{
Sigmab <- Sigma%*%b_previous
Wc <- W%*%c_vect
bSigmab <- sum(b_previous*Sigmab)
cWc <- sum(c_vect*Wc)
bVb <- (sqrt(1+4*cWc*bSigmab)-1)/(2*cWc)
theta <- 1/(1+bVb*cWc)
# V <- Sigma - lambda*tcrossprod(Sigmab)/bSigmab
# Vb <- V%*%b_previous
Vb <- theta*Sigmab
mu <- mu_X - sum(s_bar*c_vect)*Vb
c_current <- W_invM%*%(b_previous+sum(abs(b_previous))*eta)
cWc <- sum(c_current*(W%*%c_current))
Mnc <- sum((M%*%eta)*c_current)
y_tilde <- S%*%c_current
y_tilde <- scale(y_tilde)
coco <- cor(y_tilde,x)
y_tilde <- y_tilde*sign(coco)[which.max(abs(coco))]
res_lasso <- getLassoCGD(x_tilde,y_tilde,lambda,b_1,errorMin=errorMin,maxIter=maxIter)
b_iter <- t(apply(res_lasso,1,function(ro){ro*sdx}))
b_1_all <- na.omit(rowSums(abs(b_iter)))
pos_b <- which.min(abs(b_1_all-b_1))
b <- b_iter[pos_b,]
error <- sum((b-b_previous)^2)
denom <- (sum(b^2)+sum(b_previous^2))/2
if(denom>errorMin)
{
error <- error/denom
}
else
{
error <- 0
}
b_previous <- b
b_1_all <- apply(b_iter,1,function(ro){sum(abs(ro))})
if(iter==maxIter | error<errorMin)
{
test <- F
}
else
{
iter <- iter + 1
}
}
if(toPlot)
{
b1_plot = b1_plot_0 <- b_iter
b1_plot[which(b1_plot==0)] <- NA
b1_plot_0[which(b1_plot_0!=0)] <- NA
matplot(b_1_all,b1_plot,lwd=1,type="l",lty=1,
xlab=expression("|b|"[1]),ylab="Coefficients",
main="Lasso path for last iteration")
matplot(b_1_all,b1_plot,type="p",pch=16,cex=1/2,add=T)
matplot(b_1_all,b1_plot_0,type="l",lt=1,pch=16,cex=1/2,add=T)
abline(h=0,lty=2)
abline(v=b_1,lty=2)
}
out <- b
# if(sum(abs(out))!=0)
# {
#   out <- out/sqrt(sum((out)^2))
# }
out
list(b=out,b1=b_1_all)
}
bootstrapStabSparseSIR <- function(X,Y,H,B=10,lambda,b_1_s,eta,
errorMin=1e-4,maxIter=5,toPlot=T)
{
n <- nrow(X)
p <- ncol(X)
id <- matrix(sample(1:n,B*n,replace = T),n)
bbs <- list()
for(i_B in 1:B)
{
cat(i_B);cat(" ")
bb_k <- matrix(NA,p,length(b_1_s))
for(k in 1:length(b_1_s))
{
bb_k[,k] <- sparseSIR(X[id[,i_B],,drop=F],Y[id[,i_B]],H=H,lambda = lambda,b_1=b_1_s[k],
eta,errorMin=errorMin,maxIter=maxIter)$b
}
bbs[[i_B]] <- bb_k
}
measure <- rep(NA,length(b_1_s))
for(k in 1:length(b_1_s))
{
mamou <- matrix(NA,p,B)
for(i_B in 1:B)
{
mamou[,i_B] <- bbs[[i_B]][,k]
}
sum_b_k <- rowSums(mamou)
mu_total <- mean(means)
measure[k] <- sum((sum_b_k-mu_total)^2)/sum((mamou-mu_total)^2)
}
id <- which.max(measure)
mamou <- matrix(NA,p,B)
for(i_B in 1:B)
{
mamou[,i_B] <- bbs[[i_B]][,id]
}
if(toPlot)
{
par(mfrow=c(1,2))
plot(b_1_s,measure,xlab=expression("|b|"[1]),
ylab="Criterion",
main=expression("Fisher adapted criterion versus"~"|b|"[1]))
points(b_1_s[id],measure[id],pch=16,cex=2,col=2)
boxplot(t(mamou),col=1:p,main="Distributions per coordinate",
xlab="Index")
}
browser()
model <- sparseSIR(X,Y,H=H,lambda = lambda,b_1=b_1_s[id],
eta,errorMin=errorMin,maxIter=maxIter)
list(model=model,b1=b_1_s[id],id=id,fisher=measure,bestBoot=mamou)
}
## Bootstrap result
mo_boot <- bootstrapStabSparseSIR(X,Y,H,B=5,lambda,b_1_s,eta,
errorMin=1e-5,maxIter=10,toPlot=T)

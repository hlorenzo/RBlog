y_tilde <- y_tilde*sign(coco)[which.max(abs(coco))]
res_lasso <- getLassoCGD(x_tilde,y_tilde,lambda,b_1,errorMin=errorMin,maxIter=maxIter)
b_iter <- t(apply(res_lasso,1,function(ro){ro*sdx}))
b_1_all <- na.omit(rowSums(abs(b_iter)))
pos_b <- which.min(abs(b_1_all-b_1))
b <- b_iter[pos_b,]
error <- sum((b-b_previous)^2)
denom <- (sum(b^2)+sum(b_previous^2))/2
if(denom>errorMin)
{
error <- error/denom
}
else
{
error <- 0
}
b_previous <- b
b_1_all <- apply(b_iter,1,function(ro){sum(abs(ro))})
if(iter==maxIter | error<errorMin)
{
test <- F
}
else
{
iter <- iter + 1
}
}
if(toPlot)
{
b1_plot = b1_plot_0 <- b_iter
b1_plot[which(b1_plot==0)] <- NA
b1_plot_0[which(b1_plot_0!=0)] <- NA
matplot(b_1_all,b1_plot,lwd=1,type="l",lty=1,

bootstrapStabSparseSIR <- function(X,Y,H,B=10,lambda,b_1_s,eta,
errorMin=1e-4,maxIter=5,toPlot=T)
{
n <- nrow(X)
p <- ncol(X)
id <- matrix(sample(1:n,B*n,replace = T),n)
bbs <- list()
for(i_B in 1:B)
{
cat(i_B);cat(" ")
bb_k <- matrix(NA,p,length(b_1_s))
for(k in 1:length(b_1_s))
{
bb_k[,k] <- sparseSIR(X[id[,i_B],,drop=F],Y[id[,i_B]],H=H,lambda = lambda,b_1=b_1_s[k],
eta,errorMin=errorMin,maxIter=maxIter)$b
}
bbs[[i_B]] <- bb_k
}
measure <- rep(NA,length(b_1_s))
for(k in 1:length(b_1_s))
{
mamou <- matrix(NA,p,B)
for(i_B in 1:B)
{
mamou[,i_B] <- bbs[[i_B]][,k]
}
# sum_b_k <- rowSums(mamou)
mu_total <- mean(mamou)
mamouDiff <- mamou-mu_total
numer <- sum(rowSums(mamouDiff/B)^2)
denom <- sum(mamouDiff^2/B)
measure[k] <- numer/denom
}
id <- which.max(measure)
mamou <- matrix(NA,p,B)
for(i_B in 1:B)
{
mamou[,i_B] <- bbs[[i_B]][,id]
}
if(toPlot)
{
par(mfrow=c(1,2))
plot(b_1_s,measure,xlab=expression("|b|"[1]),
ylab="Criterion",
main=expression("Fisher adapted criterion versus"~"|b|"[1]))
points(b_1_s[id],measure[id],pch=16,cex=2,col=2)
boxplot(t(mamou),col=1:p,main="Distributions per coordinate",
xlab="Index")
}
browser()
model <- sparseSIR(X,Y,H=H,lambda = lambda,b_1=b_1_s[id],
eta,errorMin=errorMin,maxIter=maxIter)
list(model=model,b1=b_1_s[id],id=id,fisher=measure,bestBoot=mamou)
}
## Bootstrap result
mo_boot <- bootstrapStabSparseSIR(X,Y,H,B=5,lambda,b_1_s,eta,
errorMin=1e-5,maxIter=10,toPlot=T)

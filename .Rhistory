doPFA <- function(z,R=1,
maxIter=300,errorMin=1e-5)
{
test <- T
iter <- 1
p_plus_q <- ncol(z)
F_hat <- matrix(rnorm(R*p_plus_q),R)
Sigma_hat <- diag(runif(ncol(z),max = 0.1))
mu <- colMeans(z)
Mu <- matrix(rep(mu,n),nrow = n,byrow = T)
covz <- crossprod(z-Mu)/n
errs <- rep(NA,maxIter)
while(test)
{
inv_main <- solve(Sigma_hat+crossprod(F_hat))
beta <- t(F_hat%*%inv_main)
Esp_1 <- (z-Mu)%*%beta
Esp_2 <- matrix(0,nrow(F_hat),nrow(F_hat))
for(i in 1:n)
{
Esp_2i <- -F_hat%*%beta + t(beta)%*%tcrossprod(z[i,]-mu)%*%beta
diag(Esp_2i) <- diag(Esp_2i) + 1
Esp_2 <- Esp_2 + Esp_2i
}
coco <- crossprod(z-Mu,Esp_1)
F_hat_next <- t(coco%*%solve(Esp_2))
Sigma_hat_next <- diag(diag(covz-1/n*t(F_hat_next)%*%t(coco)))
iter <- iter + 1
errs[iter] <- mean(abs(diag(Sigma_hat_next)-diag(Sigma_hat)))
Sigma_hat <- Sigma_hat_next
F_hat <- F_hat_next
if(iter==maxIter | errs[iter]<errorMin)
{
test <- F
}
}
list(F_hat=F_hat,Esp_1=Esp_1,Sigma_hat=Sigma_hat,
errs=errs,Mu=Mu)
}
F_ <- cbind(c(1,1,0),c(0,1,0),c(2,0,1),c(0,0,1))
n <- 300
phi <- matrix(rnorm(n*nrow(F_)),n,nrow(F_))
E <- 0.1*matrix(rnorm(n*ncol(F_)),nrow = n)
z <- phi%*%F_+E
idx <- 1:2
idy <- 3:4
x <- z[,idx,drop=F]
y <- z[,idy,drop=F]
PFA_global <- doPFA(z,R=3)
Esp_1 <- PFA_global$Esp_1
Mux <- Mu[,idx]
Muy <- Mu[,idy]
sysx <- crossprod(cov(Esp_1,z[,idy]),cov(Esp_1,z[,idx]))
sxsx <- crossprod(cov(Esp_1,z[,idx]),cov(Esp_1,z[,idx]))
sysy <- crossprod(cov(Esp_1,z[,idy]),cov(Esp_1,z[,idy]))
beta_hat <- t(solve(tcrossprod(sysx))%*%t(crossprod(sysx,sysy)))
par(mfrow=c(1,2))
matplot(PFA_global$errs[1:iter],type="l")
# matplot(errs[1:iter],type="p",add=T,pch=16)
plot(z,Esp_1%*%PFA_global$F_hat+PFA_global$Mu);abline(0,1)
r_tilde <- y-Muy-(x-Mux)%*%(beta_hat)

{
X_js[[h]] <- colMeans(x[which(slices==h),,drop=F])
}
mu_X <- colMeans(X)
M <- matrix(0,H,p)
for(h in 1:H)
{
M[h,] <- s_bar[h]*(X_js[[h]]-mu_X)
}
W_inv <- matrix(1/(H+1),H,H) + diag(s_bar)
W_invM <- W_inv%*%M
Sigma <- cov(x)
test <- T
iter <- 1
c_vect <- rnorm(h)
b_previous <- rnorm(p)
while(test)
{
Sigmab <- Sigma%*%b_previous
Wc <- W%*%c_vect
bSigmab <- sum(b_previous*Sigmab)
cWc <- sum(c_vect*Wc)
bVb <- (sqrt(1+4*cWc*bSigmab)-1)/(2*cWc)
theta <- 1/(1+bVb*cWc)
# V <- Sigma - lambda*tcrossprod(Sigmab)/bSigmab
# Vb <- V%*%b_previous
Vb <- theta*Sigmab
mu <- mu_X - sum(s_bar*c_vect)*Vb
c_current <- W_invM%*%(b_previous+sum(abs(b_previous))*eta)
cWc <- sum(c_current*(W%*%c_current))
Mnc <- sum((M%*%eta)*c_current)
y_tilde <- S%*%c_current
y_tilde <- scale(y_tilde)

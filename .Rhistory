getLassoCGD <- function(X,y,lambda,b_1,errorMin=1e-5,maxIter=50)
{
p <- ncol(X)
n <- nrow(X)
N <- length(lambda)
beta_estimate<- matrix(NA,N,p)
# for(l in 1:N){
l <- 1
TEST <- T
while(TEST)
{
b <- rep(0,p)
r <- y
lam <- lambda[l]*n
test <- T
iter <- 0
while(test)
{
b_previous<-b
for(j in 1:p){
r <- r+X[,j]*b[j]
Xj<-(sum(X[,j]*X[,j]))^(-1)
z<-sum(X[,j]*r)
b[j] <- (abs(z)-lam)*Xj
b[j] <- sign(z)*ifelse(b[j]>0,b[j],0)
r <- r-X[,j]*b[j]
}
error<-sum((b_previous-b)^2)
if(iter==maxIter | error<errorMin)
{
test <- F
}
else
{
iter <- iter + 1
}
}
b_1_l <- sum(abs(b))
beta_estimate[l,] <- b
if(l==N | b_1_l>b_1)
{
TEST <- F
}
else
{
l <- l+1
}
}
beta_estimate
}
sparseSIR <- function(X,Y,H=10,lambda,b_1=0.5,eta,
errorMin=1e-9,maxIter=50,
toPlot=F){
n <- nrow(X)
p <- ncol(X)
ordo <- order(Y)
x <- X[ordo,,drop=F]
sdx <- apply(x,2,sd)
x_tilde <- scale(x)
y <- Y[ordo]
reste <- n%%H
pace <- (n-reste)/H
slices <- NULL
n_j <- NULL
for(h in 1:H)
{
extra <- 0
if(h<=reste) extra <- 1
pace_h <- pace + extra
slices <- c(slices,rep(h,pace_h))
n_j <- c(n_j,pace_h)
}
S <- do.call(cbind,lapply(1:H,{function(h){out <- rep(0,n);out[which(slices==h)]<-1;out}}))
W <- cov(S)
s_bar <- n_j/n
X_js <- list()
